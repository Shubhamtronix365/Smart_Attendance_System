# ==========================================
# Backend Configuration (server/.env)
# ==========================================

# Database Connection (Neon DB / PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_attendance

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key
JWT_ALGORITHM=HS256

# Hardware Integration (ESP32)
DEVICE_API_KEY=esp32_device_secret_key
DEVICE_ID=ESP32_TRONIX_01

# Work Rules & Policy
STANDARD_WORK_HOURS=8
LATE_THRESHOLD_MINUTES=30
OT_MULTIPLIER=1.5

# Allowed Client Origin
FRONTEND_URL=http://localhost:3000

# ==========================================
# Frontend Configuration (client/.env.local)
# ==========================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/client
