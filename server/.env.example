# Database Connection (Neon DB / Local PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_attendance

# Authentication & Security
JWT_SECRET=generate_a_random_64_character_hex_secret_here
JWT_ALGORITHM=HS256

# ESP32 Tronix Hardware Authorization Key
DEVICE_API_KEY=esp32_device_secret_key

# Shift & Attendance Policies
STANDARD_WORK_HOURS=8
LATE_THRESHOLD_MINUTES=30
OT_MULTIPLIER=1.5

# Allowed Frontend URL (Cloudflare Pages or Localhost)
FRONTEND_URL=http://localhost:3000
